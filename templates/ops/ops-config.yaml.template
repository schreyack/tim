# ops-config.yaml - TIM Ops Configuration
# Copy this file to your project root and customize
#
# Required fields are marked with (REQUIRED)
# Environment variables can be used: ${VAR_NAME}

# =============================================================================
# PROJECT IDENTIFICATION (REQUIRED)
# =============================================================================
project:
  name: "your-project-name"          # (REQUIRED) Used for container naming, logging
  environment: "production"           # production, staging, development

# =============================================================================
# REMOTE SERVER (REQUIRED for remote deployments)
# =============================================================================
remote:
  host: "your-server.example.com"    # (REQUIRED) Remote server hostname/IP
  user: "deploy"                      # (REQUIRED) SSH user
  path: "/opt/apps/your-project"      # (REQUIRED) Remote project path
  ssh_key: ""                         # Optional: path to SSH key (uses default if empty)

# =============================================================================
# SERVICES (REQUIRED - at least one)
# =============================================================================
# Define each service that makes up your application
# The library will manage containers named: {project_name}-{service_name}

services:
  backend:
    container: "your-project-backend"  # Container name (optional, defaults to project-service)
    port: 5002                         # Exposed port
    health_endpoint: "/health"         # Health check endpoint (empty to skip)
    dockerfile: "backend/Dockerfile"   # Path to Dockerfile
    watch_paths:                       # Paths to watch for changes
      - "backend/app/**/*.py"
      - "backend/requirements.txt"
      - "backend/Dockerfile"

  frontend:
    container: "your-project-frontend"
    port: 3000
    health_endpoint: "/"
    dockerfile: "frontend/Dockerfile"
    watch_paths:
      - "frontend/src/**/*.ts"
      - "frontend/src/**/*.tsx"
      - "frontend/package.json"
      - "frontend/Dockerfile"

  worker:
    container: "your-project-worker"
    port: ""                           # No port for background workers
    health_endpoint: ""                # No health check for workers
    dockerfile: "backend/Dockerfile"
    watch_paths:
      - "backend/app/tasks/**/*.py"

# =============================================================================
# DATABASE
# =============================================================================
database:
  type: "postgresql"                   # postgresql, mysql
  container: "your-project-db"         # Database container name
  migration_command: "alembic upgrade head"   # Command to run migrations
  rollback_command: "alembic downgrade -1"    # Command to rollback
  backup_path: "/backups"              # Where to store backups

# =============================================================================
# DOCKER CONFIGURATION
# =============================================================================
docker:
  compose_file: "docker/docker-compose.yml"   # Path to docker-compose file

# =============================================================================
# DEPLOYMENT SETTINGS
# =============================================================================
deploy:
  strategy: "rolling"                  # rolling, blue-green, recreate
  health_timeout: 60                   # Seconds to wait for healthy
  rollback_on_failure: true            # Auto-rollback if health check fails

# =============================================================================
# NOTIFICATIONS (Optional)
# =============================================================================
notifications:
  slack_webhook: "${SLACK_WEBHOOK_URL}"  # Slack webhook URL (from env var)
  on_deploy: true                        # Notify on successful deploy
  on_failure: true                       # Notify on deployment failure
  on_rollback: true                      # Notify on rollback

# =============================================================================
# CUSTOM SETTINGS (Optional)
# =============================================================================
# Add any project-specific settings here
# Access in hooks via: ${CONFIG[custom_setting_name]}

custom:
  # example_setting: "value"
