#!/usr/bin/env bash
#
# tim-lock-enforcement - Lock all TIM enforcement files
#
# Applies chflags immutable flags to prevent AI modification of
# enforcement files across the tim repo and registered projects.
#
# Usage:
#   tim-lock-enforcement              # Apply uchg (user immutable)
#   tim-lock-enforcement --schg       # Also apply schg (requires sudo)
#   tim-lock-enforcement --unlock     # Remove all locks
#   tim-lock-enforcement --status     # Show lock status
#   tim-lock-enforcement --help       # Show help

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
TIM_ROOT="$(dirname "$SCRIPT_DIR")"

source "$TIM_ROOT/libs/bash/tim-common.sh"
load_projects

# --- File lists ---

tim_repo_files() {
    local config="$TIM_ROOT/.tim-enforcement-files"
    if [[ ! -f "$config" ]]; then
        echo -e "${YELLOW}Warning: .tim-enforcement-files not found at $config${NC}" >&2
        return 1
    fi
    while IFS= read -r line; do
        line="${line%%#*}"  # strip comments
        line="${line// /}"  # trim whitespace
        [[ -n "$line" ]] && [[ -f "$TIM_ROOT/$line" ]] && echo "$TIM_ROOT/$line"
    done < "$config"
}

project_files() {
    for project in "${PROJECTS[@]}"; do
        [[ -d "$project" ]] || continue
        local config="$project/.pre-commit-config.yaml"
        [[ -f "$config" ]] && echo "$config"
        local gitignore="$project/.gitignore"
        [[ -f "$gitignore" ]] && echo "$gitignore"
        local ops="$project/ops.sh"
        [[ -f "$ops" ]] && echo "$ops"

        # Submodule enforcement files (lib/tim mirrors the tim repo)
        local sub="$project/lib/tim"
        if [[ -d "$sub" ]]; then
            while IFS= read -r line; do
                line="${line%%#*}"
                line="${line// /}"
                [[ -n "$line" ]] && [[ -f "$sub/$line" ]] && echo "$sub/$line"
            done < "$TIM_ROOT/.tim-enforcement-files"
        fi
    done
}

all_files() {
    tim_repo_files
    project_files
}

# --- Operations ---

is_uchg() {
    local flags
    flags=$(stat -f "%f" "$1" 2>/dev/null) || return 1
    [[ $(( flags & 0x000002 )) -ne 0 ]]
}

is_schg() {
    local flags
    flags=$(stat -f "%f" "$1" 2>/dev/null) || return 1
    [[ $(( flags & 0x00020000 )) -ne 0 ]]
}

show_status() {
    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${BLUE}  TIM Enforcement File Lock Status${NC}"
    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"

    local locked=0 unlocked=0

    while IFS= read -r file; do
        local rel="${file#"$TIM_ROOT"/}"
        # If file is outside TIM_ROOT, show full path
        [[ "$rel" == "$file" ]] && rel="$file"

        local has_uchg=false has_schg=false
        is_uchg "$file" && has_uchg=true
        is_schg "$file" && has_schg=true

        local status=""
        if $has_schg && $has_uchg; then
            status="${GREEN}schg+uchg${NC}"
            locked=$((locked + 1))
        elif $has_schg; then
            status="${YELLOW}schg only${NC}"
            locked=$((locked + 1))
        elif $has_uchg; then
            status="${YELLOW}uchg only${NC}"
            locked=$((locked + 1))
        else
            status="${RED}unlocked${NC}"
            unlocked=$((unlocked + 1))
        fi
        printf "  %-50s %b\n" "$rel" "$status"
    done < <(all_files)

    echo ""
    echo -e "  ${GREEN}Locked: $locked${NC}  ${RED}Unlocked: $unlocked${NC}"
}

lock_files() {
    local use_schg="$1"

    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${BLUE}  Locking TIM Enforcement Files${NC}"
    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"

    local count=0

    while IFS= read -r file; do
        local rel="${file#"$TIM_ROOT"/}"
        [[ "$rel" == "$file" ]] && rel="$file"

        chflags uchg "$file" 2>/dev/null
        echo -e "  ${GREEN}✓${NC} uchg  $rel"
        count=$((count + 1))
    done < <(all_files)

    if [[ "$use_schg" == "true" ]]; then
        echo ""
        echo -e "  ${YELLOW}Applying system immutable flags (requires sudo)...${NC}"
        while IFS= read -r file; do
            local rel="${file#"$TIM_ROOT"/}"
            [[ "$rel" == "$file" ]] && rel="$file"
            sudo chflags schg "$file" 2>/dev/null && \
                echo -e "  ${GREEN}✓${NC} schg  $rel" || \
                echo -e "  ${RED}✗${NC} schg  $rel (sudo failed)"
        done < <(all_files)
    fi

    echo ""
    echo -e "  ${GREEN}Locked $count files.${NC}"
    if [[ "$use_schg" != "true" ]]; then
        echo -e "  ${YELLOW}Tip: Run with --schg for system-level protection (requires sudo).${NC}"
    fi
}

unlock_files() {
    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${BLUE}  Unlocking TIM Enforcement Files${NC}"
    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"

    local count=0

    while IFS= read -r file; do
        local rel="${file#"$TIM_ROOT"/}"
        [[ "$rel" == "$file" ]] && rel="$file"

        sudo chflags noschg,nouchg "$file" 2>/dev/null && \
            echo -e "  ${GREEN}✓${NC} unlocked  $rel" || \
            echo -e "  ${RED}✗${NC} failed    $rel"
        count=$((count + 1))
    done < <(all_files)

    echo ""
    echo -e "  ${GREEN}Unlocked $count files.${NC}"
}

show_help() {
    echo "Usage: tim-lock-enforcement [OPTIONS]"
    echo ""
    echo "Lock all TIM enforcement files to prevent AI modification."
    echo ""
    echo "Options:"
    echo "  (none)       Apply user immutable flag (chflags uchg)"
    echo "  --schg       Also apply system immutable flag (requires sudo)"
    echo "  --unlock     Remove all immutable flags (requires sudo)"
    echo "  --status     Show lock status of all enforcement files"
    echo "  --help       Show this help"
    echo ""
    echo "Enforcement files include:"
    echo "  - Pre-commit configs and templates"
    echo "  - Code quality and compliance tools"
    echo "  - Sync scripts (sync-pre-commit, sync-claude-md)"
    echo "  - Human approval tools"
    echo "  - AI bypass prevention hooks"
    echo "  - Secrets baselines"
    echo "  - Generated configs in registered projects"
}

# --- Main ---

case "${1:-}" in
    --schg)
        lock_files true
        ;;
    --unlock)
        unlock_files
        ;;
    --status)
        show_status
        ;;
    --help|-h)
        show_help
        ;;
    "")
        lock_files false
        ;;
    *)
        echo "Unknown option: $1"
        show_help
        exit 1
        ;;
esac
