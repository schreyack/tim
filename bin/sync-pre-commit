#!/usr/bin/env python3
"""
sync-pre-commit - Generate .pre-commit-config.yaml for TIM projects.

Assembles pre-commit configs by merging a TIM base template with optional
project-specific overrides (.pre-commit-overrides.yaml).

Usage:
    sync-pre-commit              # Sync all registered projects
    sync-pre-commit --list       # List projects + detected template types
    sync-pre-commit --check      # Check which projects need updates
    sync-pre-commit <project>    # Sync specific project
"""

from __future__ import annotations

import os
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path
from typing import Any

# Third-party YAML - available via pre-commit's Python or system Python
try:
    import yaml
except ImportError:
    print("Error: PyYAML is required. Install with: pip install pyyaml")
    sys.exit(1)

SCRIPT_DIR = Path(__file__).resolve().parent
TIM_ROOT = SCRIPT_DIR.parent
TEMPLATES_DIR = TIM_ROOT / "templates"

# ANSI colors
RED = "\033[0;31m"
GREEN = "\033[0;32m"
YELLOW = "\033[0;33m"
BLUE = "\033[0;34m"
NC = "\033[0m"


def load_projects() -> list[Path]:
    """Load registered projects from .tim-projects file."""
    projects_file = TIM_ROOT / ".tim-projects"
    if not projects_file.exists():
        print(f"{YELLOW}Warning: {projects_file} not found.{NC}")
        print(f"Create it with one project path per line.")
        return []
    projects: list[Path] = []
    with open(projects_file) as f:
        for line in f:
            line = line.strip()
            if line and not line.startswith("#"):
                projects.append(Path(line))
    return projects


PROJECTS = load_projects()

HEADER_TEMPLATE = """\
# AUTO-GENERATED by tim/bin/sync-pre-commit - DO NOT EDIT DIRECTLY
#
# Source template: templates/{template_type}/.pre-commit-config.yaml
# Generated: {timestamp}
#
# To update:
#   - Base hooks: edit tim/templates/{template_type}/.pre-commit-config.yaml
#   - Project overrides: edit .pre-commit-overrides.yaml
#   - Then run: lib/tim/bin/sync-pre-commit {project_name}
#
# Run: pre-commit install

"""


def print_header(title: str) -> None:
    print(f"{BLUE}{'━' * 60}{NC}")
    print(f"{BLUE}  {title}{NC}")
    print(f"{BLUE}{'━' * 60}{NC}")


def detect_template_type(project: Path) -> str | None:
    """Auto-detect whether a project is python or node."""
    if (project / "package.json").exists():
        return "node"
    if (project / "pyproject.toml").exists() or (project / "requirements.txt").exists():
        return "python"

    # Fallback: check if existing config is a symlink pointing to a template
    config = project / ".pre-commit-config.yaml"
    if config.is_symlink():
        target = str(os.readlink(config))
        if "templates/node" in target:
            return "node"
        if "templates/python" in target:
            return "python"

    return None


def load_yaml_file(path: Path) -> dict[str, Any]:
    """Load a YAML file, returning empty dict if not found."""
    if not path.exists():
        return {}
    with open(path) as f:
        return yaml.safe_load(f) or {}


def load_template(template_type: str) -> dict[str, Any]:
    """Load a base pre-commit template."""
    template_path = TEMPLATES_DIR / template_type / ".pre-commit-config.yaml"
    if not template_path.exists():
        print(f"{RED}Error: Template not found: {template_path}{NC}")
        sys.exit(1)
    return load_yaml_file(template_path)


def collect_all_hook_ids(repos: list[dict[str, Any]]) -> set[str]:
    """Collect all hook IDs from a list of repos."""
    ids: set[str] = set()
    for repo in repos:
        for hook in repo.get("hooks", []):
            hook_id = hook.get("id")
            if hook_id:
                ids.add(hook_id)
    return ids


def merge_config(
    base: dict[str, Any],
    overrides: dict[str, Any],
) -> dict[str, Any]:
    """Merge base template with project overrides.

    Overrides can:
    - disable: list of hook IDs to remove from base
    - repos: additional repos to append
    """
    result = dict(base)
    disable_ids = set(overrides.get("disable", []))

    if disable_ids:
        filtered_repos: list[dict[str, Any]] = []
        for repo in result.get("repos", []):
            filtered_hooks = [
                hook
                for hook in repo.get("hooks", [])
                if hook.get("id") not in disable_ids
            ]
            if filtered_hooks:
                repo_copy = dict(repo)
                repo_copy["hooks"] = filtered_hooks
                filtered_repos.append(repo_copy)
        result["repos"] = filtered_repos

    extra_repos = overrides.get("repos", [])
    if extra_repos:
        result.setdefault("repos", []).extend(extra_repos)

    return result


def generate_header(template_type: str, project_name: str) -> str:
    """Generate the auto-generated file header."""
    timestamp = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    return HEADER_TEMPLATE.format(
        template_type=template_type,
        timestamp=timestamp,
        project_name=project_name,
    )


def unlock_file(path: Path) -> None:
    """Remove immutable flags if present (both system and user)."""
    if not path.exists():
        return
    try:
        subprocess.run(
            ["sudo", "-n", "chflags", "noschg", str(path)],
            check=False,
            capture_output=True,
        )
        subprocess.run(
            ["chflags", "nouchg", str(path)],
            check=False,
            capture_output=True,
        )
    except FileNotFoundError:
        pass  # chflags not available (non-macOS)


def lock_file(path: Path) -> None:
    """Set user immutable flag (no sudo needed)."""
    try:
        subprocess.run(
            ["chflags", "uchg", str(path)],
            check=False,
            capture_output=True,
        )
    except FileNotFoundError:
        pass  # chflags not available (non-macOS)


def is_file_locked(path: Path) -> bool:
    """Check if file has the user immutable flag set."""
    if not path.exists():
        return False
    try:
        result = subprocess.run(
            ["stat", "-f", "%f", str(path)],
            capture_output=True,
            text=True,
            check=False,
        )
        if result.returncode == 0:
            flags = int(result.stdout.strip())
            return bool(flags & 0x000001)  # UF_IMMUTABLE
    except (FileNotFoundError, ValueError):
        pass
    return False


def write_config(
    project: Path,
    template_type: str,
    project_name: str,
    config: dict[str, Any],
) -> None:
    """Write the merged config with header, then lock the file."""
    output_path = project / ".pre-commit-config.yaml"

    # Remove symlink if present
    if output_path.is_symlink():
        # Unlock the symlink (may have schg flag)
        try:
            subprocess.run(
                ["chflags", "-h", "noschg", str(output_path)],
                check=False,
                capture_output=True,
            )
            subprocess.run(
                ["chflags", "-h", "nouchg", str(output_path)],
                check=False,
                capture_output=True,
            )
        except FileNotFoundError:
            pass
        output_path.unlink()

    unlock_file(output_path)

    header = generate_header(template_type, project_name)
    yaml_content = yaml.dump(config, default_flow_style=False, sort_keys=False)

    with open(output_path, "w") as f:
        f.write(header)
        f.write(yaml_content)

    lock_file(output_path)


def has_autogen_header(path: Path) -> bool:
    """Check if a file has the AUTO-GENERATED header."""
    if not path.exists() or path.is_symlink():
        return False
    try:
        with open(path) as f:
            first_line = f.readline()
            return "AUTO-GENERATED by tim/bin/sync-pre-commit" in first_line
    except OSError:
        return False


def needs_sync(project: Path, template_type: str) -> tuple[bool, str]:
    """Check if a project's pre-commit config needs regeneration.

    Returns (needs_sync, reason).
    """
    config_path = project / ".pre-commit-config.yaml"

    if not config_path.exists():
        return True, "config missing"

    if config_path.is_symlink():
        return True, "still a symlink (needs migration)"

    if not has_autogen_header(config_path):
        return True, "missing AUTO-GENERATED header"

    # Check timestamps
    template_path = TEMPLATES_DIR / template_type / ".pre-commit-config.yaml"
    overrides_path = project / ".pre-commit-overrides.yaml"

    config_mtime = config_path.stat().st_mtime

    if template_path.stat().st_mtime > config_mtime:
        return True, "base template is newer"

    if overrides_path.exists() and overrides_path.stat().st_mtime > config_mtime:
        return True, "overrides file is newer"

    return False, "up to date"


def list_projects() -> None:
    """List all registered projects with detected types."""
    print_header("Registered TIM Projects")
    for project in PROJECTS:
        name = project.name
        if not project.is_dir():
            print(f"  {RED}✗{NC} {name} - directory not found")
            continue
        ttype = detect_template_type(project)
        config = project / ".pre-commit-config.yaml"
        if ttype:
            status = "symlink" if config.is_symlink() else (
                "generated" if has_autogen_header(config) else "manual"
            )
            locked = " [locked]" if is_file_locked(config) else ""
            print(f"  {GREEN}✓{NC} {name} ({ttype}) - {status}{locked}")
        else:
            print(f"  {YELLOW}!{NC} {name} - unable to detect type")


def check_projects() -> int:
    """Check which projects need updates. Returns count needing sync."""
    print_header("Checking Pre-commit Config Status")
    needs_update = 0

    for project in PROJECTS:
        name = project.name
        if not project.is_dir():
            print(f"  {RED}✗{NC} {name} - directory not found")
            continue

        ttype = detect_template_type(project)
        if not ttype:
            print(f"  {YELLOW}!{NC} {name} - unable to detect type, skipping")
            continue

        should_sync, reason = needs_sync(project, ttype)
        if should_sync:
            print(f"  {YELLOW}↻{NC} {name} ({ttype}) - {reason}")
            needs_update += 1
        else:
            print(f"  {GREEN}✓{NC} {name} ({ttype}) - {reason}")

    return needs_update


def sync_project(project: Path) -> Path | None:
    """Sync a single project. Returns output path on success, None on failure."""
    name = project.name

    if not project.is_dir():
        print(f"  {RED}✗{NC} {name} - directory not found: {project}")
        return None

    ttype = detect_template_type(project)
    if not ttype:
        print(f"  {RED}✗{NC} {name} - unable to detect project type")
        print(f"      Add package.json (node) or pyproject.toml (python)")
        return None

    base = load_template(ttype)
    overrides = load_yaml_file(project / ".pre-commit-overrides.yaml")

    if overrides:
        disabled = overrides.get("disable", [])
        extra = len(overrides.get("repos", []))
        parts = []
        if disabled:
            parts.append(f"disabled {len(disabled)} hooks")
        if extra:
            parts.append(f"added {extra} repos")
        print(f"  {BLUE}⚙{NC} {name} - applying overrides: {', '.join(parts)}")

    config = merge_config(base, overrides)
    write_config(project, ttype, name, config)

    print(f"  {GREEN}✓{NC} {name} ({ttype}) - synced successfully")
    return project / ".pre-commit-config.yaml"


def print_schg_commands(synced_paths: list[Path]) -> None:
    """Print sudo chflags schg commands for the user to run."""
    if not synced_paths:
        return
    print(f"\n{YELLOW}To apply system-level lock (requires sudo):{NC}")
    for path in synced_paths:
        print(f"  sudo chflags schg {path}")


def sync_all() -> bool:
    """Sync all registered projects. Returns True if all succeed."""
    print_header("Syncing Pre-commit Configs")
    all_ok = True
    synced_paths: list[Path] = []
    for project in PROJECTS:
        result = sync_project(project)
        if result is None:
            all_ok = False
        else:
            synced_paths.append(result)

    print()
    if all_ok:
        print(f"{GREEN}All projects synced successfully.{NC}")
    else:
        print(f"{YELLOW}Some projects failed to sync. See errors above.{NC}")

    print_schg_commands(synced_paths)
    return all_ok


def sync_one(target: str) -> bool:
    """Sync a specific project by name or path."""
    for project in PROJECTS:
        if project.name == target or str(project) == target:
            print_header(f"Syncing {project.name}")
            result = sync_project(project)
            if result is not None:
                print_schg_commands([result])
                return True
            return False

    print(f"{RED}Error: Project '{target}' not found in registered projects.{NC}")
    print("Run 'sync-pre-commit --list' to see registered projects.")
    return False


def main() -> None:
    if len(sys.argv) < 2:
        ok = sync_all()
        sys.exit(0 if ok else 1)

    arg = sys.argv[1]
    if arg in ("--list", "-l"):
        list_projects()
    elif arg in ("--check", "-c"):
        count = check_projects()
        sys.exit(1 if count > 0 else 0)
    elif arg in ("--help", "-h"):
        print("Usage: sync-pre-commit [OPTIONS] [PROJECT]")
        print()
        print("Options:")
        print("  --list, -l     List projects + detected template types")
        print("  --check, -c    Check which projects need updates")
        print("  --help, -h     Show this help")
        print()
        print("If PROJECT is specified, only that project is synced.")
        print("If no arguments, all projects are synced.")
    else:
        ok = sync_one(arg)
        sys.exit(0 if ok else 1)


if __name__ == "__main__":
    main()
