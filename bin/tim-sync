#!/usr/bin/env bash
#
# tim-sync - Push TIM standards to all registered projects
# Run after committing/pushing changes to the TIM repo.
# Use --help for usage.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TIM_ROOT="$(dirname "$SCRIPT_DIR")"

source "$TIM_ROOT/libs/bash/tim-common.sh"
load_projects

NO_PUSH=false
UNLOCKED=false
FAILED_PROJECTS=()
UPDATED_PROJECTS=()
CURRENT_PROJECTS=()

print_header() { echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n  $1\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"; }

# --- Pre-flight ---

preflight() {
    [[ -z "$(git -C "$TIM_ROOT" status --porcelain 2>/dev/null)" ]] \
        || { echo -e "${RED}Error: TIM repo has uncommitted changes.${NC}"; exit 1; }
    local unpushed
    unpushed=$(git -C "$TIM_ROOT" log @{u}..HEAD --oneline 2>/dev/null || echo "")
    if [[ -n "$unpushed" ]]; then
        echo -e "${BLUE}Pushing TIM repo...${NC}"
        git -C "$TIM_ROOT" push --quiet 2>/dev/null \
            || { echo -e "${RED}Error: TIM repo push failed.${NC}"; exit 1; }
        echo -e "${GREEN}✓${NC} TIM repo pushed"
    fi
}

# --- Unlock / relock ---

do_unlock() {
    sudo "$TIM_ROOT/bin/tim-lock-enforcement" --unlock
    UNLOCKED=true
}

do_relock() {
    $UNLOCKED || return 0
    echo ""
    sudo "$TIM_ROOT/bin/tim-lock-enforcement" --schg
}

# --- Per-project sync ---

sync_project() {
    local project="$1"
    local name
    name=$(basename "$project")

    if [[ ! -d "$project" ]]; then
        echo -e "  ${RED}✗ directory not found: $project${NC}"
        return 1
    fi

    # 1. Init + update submodule
    if [[ -d "$project/lib/tim" ]]; then
        # Init if empty (never had submodule update --init)
        if [[ ! -f "$project/lib/tim/CLAUDE.md" ]]; then
            if ! git -C "$project" submodule update --init lib/tim 2>/dev/null; then
                # SSH URL may fail — rewrite to HTTPS and retry
                local sub_url
                sub_url=$(git -C "$project" config --file .gitmodules submodule.lib/tim.url 2>/dev/null || true)
                if [[ "$sub_url" == git@github.com:* ]]; then
                    local https_url="https://github.com/${sub_url#git@github.com:}"
                    git -C "$project" config submodule.lib/tim.url "$https_url"
                    git -C "$project" submodule update --init lib/tim 2>/dev/null \
                        && echo -e "  ${GREEN}✓${NC} submodule initialized (rewrote SSH→HTTPS)" \
                        || echo -e "  ${RED}✗${NC} submodule init failed"
                else
                    echo -e "  ${RED}✗${NC} submodule init failed"
                fi
            else
                echo -e "  ${GREEN}✓${NC} submodule initialized"
            fi
        fi
        local before after
        before=$(git -C "$project/lib/tim" rev-parse HEAD 2>/dev/null)
        git -C "$project/lib/tim" checkout -- . 2>/dev/null || true
        if git -C "$project/lib/tim" pull origin main --quiet 2>/dev/null; then
            after=$(git -C "$project/lib/tim" rev-parse HEAD 2>/dev/null)
            if [[ "$before" != "$after" ]]; then
                echo -e "  ${GREEN}✓${NC} submodule updated"
            else
                echo -e "  ${YELLOW}—${NC} submodule already current"
            fi
        else
            echo -e "  ${RED}✗${NC} submodule pull failed"
        fi
        # Verify critical content exists
        if [[ ! -d "$project/lib/tim/tools" ]]; then
            echo -e "  ${RED}✗${NC} submodule content missing (tools/ not found)"
        fi
    else
        echo -e "  ${YELLOW}—${NC} no lib/tim submodule"
    fi

    # 2. Sync pre-commit config
    if "$TIM_ROOT/bin/sync-pre-commit" "$name" >/dev/null 2>&1; then
        echo -e "  ${GREEN}✓${NC} pre-commit config synced"
    else
        echo -e "  ${RED}✗${NC} pre-commit config sync failed"
    fi

    # 3. Sync CLAUDE.md
    if "$TIM_ROOT/bin/sync-claude-md" "$name" >/dev/null 2>&1; then
        echo -e "  ${GREEN}✓${NC} CLAUDE.md synced"
    else
        echo -e "  ${RED}✗${NC} CLAUDE.md sync failed"
    fi

    # 4. Scaffold .claude/settings.local.json if missing
    local settings_path="$project/.claude/settings.local.json"
    if [[ ! -f "$settings_path" ]]; then
        local project_name=""
        if [[ -f "$project/ops-config.yaml" ]]; then
            project_name=$(grep -A1 '^project:' "$project/ops-config.yaml" | grep 'name:' | sed 's/.*name:[[:space:]]*//' | tr -d '"' | tr -d "'")
        fi
        project_name="${project_name:-$name}"
        mkdir -p "$project/.claude"
        sed "s/{{PROJECT_NAME}}/$project_name/g" "$TIM_ROOT/templates/settings.local.json.template" > "$settings_path"
        echo -e "  ${GREEN}✓${NC} scaffolded .claude/settings.local.json (project: $project_name)"
    else
        echo -e "  ${YELLOW}—${NC} .claude/settings.local.json exists"
    fi

    # 5. Scaffold .pre-commit-overrides.yaml if mypy hook will fail
    if [[ ! -f "$project/.pre-commit-overrides.yaml" ]] \
        && grep -q "mypy" "$project/.pre-commit-config.yaml" 2>/dev/null; then
        local mypy_path=".venv/bin/mypy"
        grep -q "backend/.venv" "$project/.pre-commit-config.yaml" 2>/dev/null && mypy_path="backend/.venv/bin/mypy"
        if [[ ! -f "$project/$mypy_path" ]]; then
            cat > "$project/.pre-commit-overrides.yaml" <<'OVERRIDE'
# Auto-generated by tim-sync — mypy venv not found at sync time.
# To enable mypy: set up your venv, then replace this with proper config.
# See jamphoria/.pre-commit-overrides.yaml for a full example.
disable:
  - mypy
OVERRIDE
            echo -e "  ${GREEN}✓${NC} scaffolded .pre-commit-overrides.yaml (mypy disabled — no venv)"
            # Re-sync pre-commit config with the new overrides
            "$TIM_ROOT/bin/sync-pre-commit" "$name" >/dev/null 2>&1
        fi
    else
        [[ -f "$project/.pre-commit-overrides.yaml" ]] && echo -e "  ${YELLOW}—${NC} .pre-commit-overrides.yaml exists"
    fi

    # 6. Ensure pre-commit hooks are installed
    if [[ -f "$project/.git/hooks/pre-commit" ]] && grep -q "pre-commit" "$project/.git/hooks/pre-commit" 2>/dev/null; then
        echo -e "  ${YELLOW}—${NC} pre-commit hooks installed"
    else
        if (cd "$project" && pre-commit install) >/dev/null 2>&1; then
            echo -e "  ${GREEN}✓${NC} pre-commit hooks installed"
        else
            echo -e "  ${RED}✗${NC} pre-commit install failed"
        fi
    fi

    # 6. Generate .secrets.baseline if detect-secrets hook exists but baseline doesn't
    if grep -q "detect-secrets" "$project/.pre-commit-config.yaml" 2>/dev/null; then
        if [[ ! -f "$project/.secrets.baseline" ]]; then
            if (cd "$project" && detect-secrets scan > .secrets.baseline) 2>/dev/null; then
                echo -e "  ${GREEN}✓${NC} generated .secrets.baseline"
            else
                echo -e "  ${RED}✗${NC} detect-secrets scan failed"
            fi
        else
            echo -e "  ${YELLOW}—${NC} .secrets.baseline exists"
        fi
    fi

    # 7. Ensure .gitignore has required entries + plans/ exists
    local gi="$project/.gitignore"
    [[ -f "$gi" ]] && for entry in ".secrets.baseline.bak" ".env" ".env.*"; do
        grep -qxF "$entry" "$gi" 2>/dev/null || echo "$entry" >> "$gi"
    done
    for dir in drafts active completed abandoned; do mkdir -p "$project/plans/$dir"; done
    [[ -f "$project/plans/drafts/.gitkeep" ]] || touch "$project/plans/drafts/.gitkeep"

    # 8. Stage changes
    git -C "$project" add -f lib/tim .pre-commit-config.yaml CLAUDE.md 2>/dev/null || true

    # 8. Commit if anything staged
    if git -C "$project" diff --cached --quiet 2>/dev/null; then
        echo -e "  ${YELLOW}—${NC} nothing to commit"
        CURRENT_PROJECTS+=("$name")
        return 0
    fi

    git -C "$project" commit --no-verify -m "chore: sync TIM standards" --quiet
    echo -e "  ${GREEN}✓${NC} committed: chore: sync TIM standards"
    UPDATED_PROJECTS+=("$name")

    # 9. Push
    if $NO_PUSH; then
        echo -e "  ${YELLOW}—${NC} push skipped (--no-push)"
    elif git -C "$project" push --quiet 2>/dev/null; then
        echo -e "  ${GREEN}✓${NC} pushed"
    else
        echo -e "  ${RED}✗${NC} push failed"
    fi
}

# --- Summary ---

print_summary() {
    local total=$1 updated=${#UPDATED_PROJECTS[@]} failed=${#FAILED_PROJECTS[@]}
    local summary="Synced $total projects ($updated updated, $((total - updated - failed)) current"
    [[ $failed -gt 0 ]] && summary+=", $failed failed"
    print_header "$summary)"
    [[ $failed -gt 0 ]] && echo -e "\n${RED}Failed: ${FAILED_PROJECTS[*]}${NC}"
}

# --- Register ---

register_project() {
    local raw_path="$1"
    local abs_path
    abs_path="$(cd "$raw_path" 2>/dev/null && pwd)" || {
        echo -e "${RED}Error: directory not found: $raw_path${NC}"; return 1
    }
    if [[ ! -d "$abs_path/lib/tim" ]]; then
        echo -e "${RED}Error: $abs_path has no lib/tim submodule${NC}"
        echo "Add the submodule first: git submodule add <tim-url> lib/tim"
        return 1
    fi
    local projects_file="$TIM_ROOT/.tim-projects"
    if [[ -f "$projects_file" ]]; then
        while IFS= read -r line || [[ -n "$line" ]]; do
            [[ -z "$line" || "$line" == \#* ]] && continue
            if [[ "$line" == "$abs_path" ]]; then
                echo -e "${YELLOW}Already registered: $abs_path${NC}"; return 0
            fi
        done < "$projects_file"
    fi
    echo "$abs_path" >> "$projects_file"
    echo -e "${GREEN}✓${NC} Registered: $(basename "$abs_path") ($abs_path)"
}

# --- Modes ---

sync_all() {
    preflight
    print_header "TIM Sync — Pushing standards to projects"
    echo ""

    do_unlock
    trap do_relock EXIT
    echo ""

    local total=${#PROJECTS[@]}
    for i in "${!PROJECTS[@]}"; do
        local project="${PROJECTS[$i]}"
        local name
        name=$(basename "$project")
        local idx=$((i + 1))
        echo -e "${BOLD}[$idx/$total] $name${NC}"
        sync_project "$project" || FAILED_PROJECTS+=("$name")
        echo ""
    done

    print_summary "$total"
    [[ ${#FAILED_PROJECTS[@]} -eq 0 ]]
}

sync_one() {
    local target="$1"

    for project in "${PROJECTS[@]}"; do
        local name
        name=$(basename "$project")
        if [[ "$name" == "$target" || "$project" == "$target" ]]; then
            preflight
            print_header "TIM Sync — $name"
            echo ""

            do_unlock
            trap do_relock EXIT
            echo ""

            echo -e "${BOLD}[1/1] $name${NC}"
            sync_project "$project" || FAILED_PROJECTS+=("$name")
            echo ""

            print_summary 1
            [[ ${#FAILED_PROJECTS[@]} -eq 0 ]]
            return $?
        fi
    done

    echo -e "${RED}Error: Project '$target' not found in registered projects.${NC}"
    echo "Run 'tim-sync --list' to see registered projects."
    return 1
}

submodule_status() {
    local project="$1" name="$2" tim_head="$3" verbose="${4:-false}"
    if [[ ! -d "$project" ]]; then
        echo -e "  ${RED}✗${NC} $name — directory not found"; return 2
    fi
    if [[ ! -d "$project/lib/tim" ]]; then
        echo -e "  ${RED}!${NC} $name — no lib/tim submodule"; return 1
    fi
    local sub_head
    sub_head=$(git -C "$project/lib/tim" rev-parse HEAD 2>/dev/null || echo "unknown")
    if [[ "$sub_head" != "$tim_head" ]]; then
        $verbose && echo -e "  ${YELLOW}↻${NC} submodule behind (${sub_head:0:7} → ${tim_head:0:7})"
        $verbose || echo -e "  ${YELLOW}↻${NC} $name — submodule behind"
        return 1
    fi
    $verbose && echo -e "  ${GREEN}✓${NC} submodule current"
    $verbose || echo -e "  ${GREEN}✓${NC} $name"
}

check_projects() {
    print_header "TIM Sync — Dry Run"
    echo ""
    local tim_head total needs_sync=0
    tim_head=$(git -C "$TIM_ROOT" rev-parse HEAD 2>/dev/null)
    total=${#PROJECTS[@]}
    for i in "${!PROJECTS[@]}"; do
        local project="${PROJECTS[$i]}" name idx=$((i + 1))
        name=$(basename "$project")
        echo -e "${BOLD}[$idx/$total] $name${NC}"
        submodule_status "$project" "$name" "$tim_head" true && true || needs_sync=$((needs_sync + 1))
        echo ""
    done
    print_header "$needs_sync need sync, $((total - needs_sync)) current"
    [[ $needs_sync -eq 0 ]]
}

list_projects() {
    print_header "TIM Sync — Registered Projects"
    echo ""
    local tim_head
    tim_head=$(git -C "$TIM_ROOT" rev-parse HEAD 2>/dev/null)
    for project in "${PROJECTS[@]}"; do
        submodule_status "$project" "$(basename "$project")" "$tim_head" false || true
    done
}

# --- Main ---

case "${1:-}" in
    --list|-l)
        list_projects
        ;;
    --check|-c)
        check_projects
        ;;
    --register|-r)
        if [[ -z "${2:-}" ]]; then
            echo -e "${RED}Usage: tim-sync --register <project-path>${NC}"
            exit 1
        fi
        register_project "$2"
        ;;
    --no-push)
        NO_PUSH=true
        sync_all
        ;;
    --help|-h)
        cat <<'HELP'
Usage: tim-sync [OPTIONS] [PROJECT]

Push TIM standards to all registered projects.

Options:
  (none)              Sync all projects
  <project>           Sync one project by name or path
  --register, -r <p>  Register a project in .tim-projects
  --list, -l          List projects and sync status
  --check, -c         Dry run — show what would change
  --no-push           Sync and commit but don't push
  --help, -h          Show this help

Per project: update submodule, regenerate pre-commit + CLAUDE.md,
scaffold .claude/settings.local.json, install pre-commit hooks,
generate .secrets.baseline, commit and push.
HELP
        ;;
    "")
        sync_all
        ;;
    *)
        sync_one "$1"
        ;;
esac
