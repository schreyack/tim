# TIM Example API - Environment Configuration
# Copy this file to .env and fill in values

# Database connection (PostgreSQL in production)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/tim_example

# JWT Configuration
JWT_SECRET=change-this-to-a-secure-random-string-minimum-32-chars
JWT_EXPIRY_MINUTES=30

# Environment
ENVIRONMENT=development
DEBUG=true
