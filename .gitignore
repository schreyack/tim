# Local project registry (machine-specific paths)
.tim-projects

# Environment files (secrets)
.env
.env.*
!.env.example

# Plans folder (should not be in this repo)
plans/

# Comms (ephemeral cross-session working files, never committed)
comms/

# Claude Code local settings (contains personal permissions)
.claude/settings.local.json

# TIM Execution Requests (approval tokens)
**/.tim-execution-requests/*
!**/.tim-execution-requests/.gitkeep

# LLM catch logs (contain transcript excerpts)
**/llm_catches.jsonl

# Python
__pycache__/
*.pyc
*.pyo
.coverage
.pytest_cache/
*.egg-info/
dist/
build/
.mypy_cache/

# Node
node_modules/
dist/
coverage/
*.tsbuildinfo
.DS_Store
